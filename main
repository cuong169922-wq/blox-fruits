--==================================================
-- DRAG (ACTIVE ONLY WHILE DRAGGING)
--==================================================
local dragging = false
local dragStart
local dragOrigin
local dragMoveConn
local dragEndConn

local function stopDrag()
    dragging = false
    if dragMoveConn then dragMoveConn:Disconnect(); dragMoveConn = nil end
    if dragEndConn then dragEndConn:Disconnect(); dragEndConn = nil end
end

header.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
    dragging = true
    dragStart = input.Position
    dragOrigin = menu.Position
    if dragMoveConn then dragMoveConn:Disconnect() end
    if dragEndConn then dragEndConn:Disconnect() end
    dragMoveConn = UserInputService.InputChanged:Connect(function(changed)
        if not dragging then return end
        if changed.UserInputType ~= Enum.UserInputType.MouseMovement and changed.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = changed.Position - dragStart
        menu.Position = UDim2.new(
            dragOrigin.X.Scale, dragOrigin.X.Offset + delta.X,
            dragOrigin.Y.Scale, dragOrigin.Y.Offset + delta.Y
        )
    end)
    dragEndConn = UserInputService.InputEnded:Connect(function(ended)
        if ended.UserInputType == Enum.UserInputType.MouseButton1 or ended.UserInputType == Enum.UserInputType.Touch then
            stopDrag()
        end
    end)
end)

hideBtn.MouseButton1Click:Connect(function() setMenuVisible(false) end)
closeBtn.MouseButton1Click:Connect(function() setMenuVisible(false) end)
floating.MouseButton1Click:Connect(function() setMenuVisible(true) end)
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        setMenuVisible(not menu.Visible)
    end
end)

--==================================================
-- ROUTE / QUEST HELPERS
--==================================================
local MAX_LEVEL = 2800
local ABOVE_Y = 7
local QUEST_DISTANCE = 8
local MOVE_INTERVAL = 0.28
local ATTACK_INTERVAL = 0.09
local LEVEL_CHECK_DELAY = 0.15

local state = {
    level = 0,
    route = nil,
    status = IN_BLOX_FRUITS and "CHECKING LEVEL" or "NOT BLOX FRUITS",
    quest = "-",
    mob = "-",
    needLevelCheck = true,
    lastLevelCheck = -1,
    target = nil,
    activeTween = nil,
    submergedUnavailable = false,
    lastSubmergedAttempt = 0,
    lastSeaTravel = 0,
}

local function getRoot()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getCommF()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    return remotes and remotes:FindFirstChild("CommF_")
end

local function safeCommF(...)
    local comm = getCommF()
    if not comm then return false, nil end
    return pcall(function() return comm:InvokeServer(...) end)
end

local function getQuestGui()
    local pg = LP:FindFirstChild("PlayerGui")
    local main = pg and pg:FindFirstChild("Main")
    return main and main:FindFirstChild("Quest")
end

local function questVisible()
    local q = getQuestGui()
    return q and q.Visible == true or false
end

local function questTitle()
    local q = getQuestGui()
    local container = q and q:FindFirstChild("Container")
    local qt = container and container:FindFirstChild("QuestTitle")
    local title = qt and qt:FindFirstChild("Title")
    return title and tostring(title.Text) or ""
end

local function questMatches(mob)
    if not questVisible() or type(mob) ~= "string" then return false end
    return string.find(questTitle(), mob, 1, true) ~= nil
end

local function currentWorld()
    local id = game.PlaceId
    if id == 2753915549 then return 1 end
    if id == 4442272183 then return 2 end
    if id == 7449423635 then return 3 end
    return 0
end

local function travelWorld(world)
    local now = os.clock()
    if now - state.lastSeaTravel < 8 then return false end
    local here = currentWorld()
    if here == world then return true end
    state.lastSeaTravel = now
    if world == 1 then safeCommF("TravelMain") end
    if world == 2 then safeCommF("TravelDressrosa") end
    if world == 3 then safeCommF("TravelZou") end
    return false
end

local SUBMERGED_WORKER = CFrame.new(-16269.7041, 25.2288494, 1373.65955)

local function isSubmerged()
    local root = getRoot()
    if not root then return false end
    local p = root.Position
    return p.Y < -800 and p.X > 8000 and p.X < 13000 and p.Z > 7500 and p.Z < 11500
end

local function tweenTo(cf, stopDistance)
    local root = getRoot()
    if not root or not cf then return false end
    stopDistance = stopDistance or 4
    if (root.Position - cf.Position).Magnitude <= stopDistance then return true end
    if state.activeTween then pcall(function() state.activeTween:Cancel() end) end
    local distance = (root.Position - cf.Position).Magnitude
    local speed = 330
    local duration = math.clamp(distance / speed, 0.05, 4)
    local ok, tw = pcall(function()
        return TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = cf})
    end)
    if not ok or not tw then return false end
    state.activeTween = tw
    tw:Play()
    return true
end

local function stopTween()
    if state.activeTween then
        pcall(function() state.activeTween:Cancel() end)
        state.activeTween = nil
    end
end

local function equipWeapon()
    local char = LP.Character
    local hum = getHumanoid()
    if not char or not hum then return false end
    local wanted = (type(SelectWeapon) == "string" and SelectWeapon ~= "") and SelectWeapon or nil
    local current = char:FindFirstChildOfClass("Tool")
    if wanted and current and current.Name == wanted then return true end
    local backpack = LP:FindFirstChildOfClass("Backpack")
    if not backpack then return false end
    local tool = wanted and backpack:FindFirstChild(wanted) or nil
    if not tool then
        for _, obj in ipairs(backpack:GetChildren()) do
            if obj:IsA("Tool") then tool = obj; break end
        end
    end
    if not tool then return false end
    return pcall(function() hum:EquipTool(tool) end)
end

local function enableHaki()
    local char = LP.Character
    if not char then return end
    if char:FindFirstChild("HasBuso") then return end
    pcall(function() safeCommF("Buso") end)
end

-- Lazy combat access prevents CombatFramework errors from blocking the menu.
local CombatController = nil
local combatInitTried = false

local function initCombat()
    if CombatController or combatInitTried then return CombatController ~= nil end
    combatInitTried = true
    local ok = pcall(function()
        local cf = require(LP.PlayerScripts:WaitForChild("CombatFramework", 5))
        if type(debug) ~= "table" or type(debug.getupvalues) ~= "function" then return end
        local ups = debug.getupvalues(cf)
        CombatController = ups and ups[2] or nil
    end)
    return ok and CombatController ~= nil
end

local function attack()
    local char = LP.Character
    local root = getRoot()
    if not char or not root then return end

    if initCombat() and CombatController and CombatController.activeController then
        local AC = CombatController.activeController
        local ok = pcall(function()
            local RigLib = require(ReplicatedStorage:WaitForChild("CombatFramework", 5):WaitForChild("RigLib", 5))
            local hits = RigLib.getBladeHits(char, {root}, 60)
            local unique = {}
            for _, part in pairs(hits) do
                local model = part and part.Parent
                if model and model:FindFirstChild("HumanoidRootPart") then
                    unique[model] = model.HumanoidRootPart
                end
            end
            for _, hrp in pairs(unique) do
                if hrp and hrp.Parent then
                    AC:attack("click")
                    break
                end
            end
        end)
        if ok then return end
    end

    -- Executor-compatible fallback for environments that cannot expose CombatFramework.
    local vim = game:GetService("VirtualInputManager")
    if vim then
        pcall(function()
            vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end)
    elseif type(mouse1click) == "function" then
        pcall(mouse1click)
    end
end

--==================================================
-- LATE-GAME ROUTE
--==================================================
local function lateRoute(level)
    -- Submerged becomes optional; failure falls back to Tiki Outpost.
    if level < 2450 then return nil end
    if state.submergedUnavailable and level >= 2600 then
        return {world=3, area="Tiki Outpost (fallback)", mob="Isle Champion", quest="TikiQuest2", qlv=2,
            q=CFrame.new(-16542.4473, 55.6863, 1044.4165), m=CFrame.new(-16848.9414, 21.6863, 1041.4491)}
    end
    if level <= 2474 then
        return {world=3, area="Tiki Outpost", mob="Isle Outlaw", quest="TikiQuest1", qlv=1,
            q=CFrame.new(-16549.8906, 55.6864, -179.9136), m=CFrame.new(-16162.8193, 11.6863, -96.4548)}
    elseif level <= 2499 then
        return {world=3, area="Tiki Outpost", mob="Island Boy", quest="TikiQuest1", qlv=2,
            q=CFrame.new(-16549.8906, 55.6864, -179.9136), m=CFrame.new(-16912.1309, 11.7874, -133.0851)}
    elseif level <= 2524 then
        return {world=3, area="Tiki Outpost", mob="Sun-kissed Warrior", quest="TikiQuest2", qlv=1,
            q=CFrame.new(-16542.4473, 55.6863, 1044.4165), m=CFrame.new(-16217.921, 137.085, 1025.234)}
    elseif level < 2600 then
        return {world=3, area="Tiki Outpost", mob="Isle Champion", quest="TikiQuest2", qlv=2,
            q=CFrame.new(-16542.4473, 55.6863, 1044.4165), m=CFrame.new(-16848.9414, 21.6863, 1041.4491)}
    elseif level <= 2624 then
        return {world=3, area="Submerged Island", mob="Reef Bandit", quest="SubmergedQuest1", qlv=1,
            q=CFrame.new(10778.875, -2087.724, 9265.184), m=CFrame.new(11019.132, -2146.068, 9342.392)}
    elseif level <= 2649 then
        return {world=3, area="Submerged Island", mob="Coral Pirate", quest="SubmergedQuest1", qlv=2,
            q=CFrame.new(10778.875, -2087.724, 9265.184), m=CFrame.new(10808.601, -2030.361, 9364.234)}
    elseif level <= 2674 then
        return {world=3, area="Submerged Island", mob="Sea Chanter", quest="SubmergedQuest2", qlv=1,
            q=CFrame.new(10880.686, -2086.2, 10032.624), m=CFrame.new(10671.272, -2057.592, 10047.258)}
    elseif level <= 2699 then
        return {world=3, area="Submerged Island", mob="Ocean Prophet", quest="SubmergedQuest2", qlv=2,
            q=CFrame.new(10880.686, -2086.2, 10032.624), m=CFrame.new(11008.52, -2007.728, 10223.079)}
    elseif level <= 2724 then
        return {world=3, area="Submerged Island", mob="High Disciple", quest="SubmergedQuest3", qlv=1,
            q=CFrame.new(9640.088, -1992.445, 9613.652), m=CFrame.new(9750.416, -1966.939, 9753.36)}
    else
        return {world=3, area="Submerged Island", mob="Grand Devotee", quest="SubmergedQuest3", qlv=2,
            q=CFrame.new(9640.088, -1992.445, 9613.652), m=CFrame.new(9611.705, -1993.471, 9882.688)}
    end
end

local function resolveRoute(level)
    level = math.clamp(tonumber(level) or 1, 1, MAX_LEVEL)
    local late = lateRoute(level)
    if late then return late end

    local oldMonster, oldArea = SelectMonster, SelectArea
    SelectMonster, SelectArea = nil, nil
    First_Sea = currentWorld() == 1
    Second_Sea = currentWorld() == 2
    Third_Sea = currentWorld() == 3
    local ok = pcall(CheckLevel)
    SelectMonster, SelectArea = oldMonster, oldArea
    if not ok then return nil end

    if type(NameMon) ~= "string" or NameMon == "" then return nil end
    if type(NameQuest) ~= "string" or NameQuest == "" then return nil end
    if type(QuestLv) ~= "number" then return nil end
    if typeof(CFrameQ) ~= "CFrame" or typeof(CFrameMon) ~= "CFrame" then return nil end

    return {
        world = First_Sea and 1 or (Second_Sea and 2 or (Third_Sea and 3 or 0)),
        area = "Level route",
        mob = NameMon,
        quest = NameQuest,
        qlv = QuestLv,
        q = CFrameQ,
        m = CFrameMon,
    }
end

local function routeKey(r)
    return r and string.format("%s|%d|%s", r.quest, r.qlv, r.mob) or nil
end

local function tryEnterSubmerged()
    if isSubmerged() then return true end
    if os.clock() - state.lastSubmergedAttempt < 12 then return false end
    state.lastSubmergedAttempt = os.clock()
    state.status = "GOING TO SUBMERGED"
    tweenTo(SUBMERGED_WORKER, 12)
    local t = os.clock()
    while os.clock() - t < 8 and _G.LilyAutoFarmLevel do
        local root = getRoot()
        if root and (root.Position - SUBMERGED_WORKER.Position).Magnitude <= 12 then break end
        task.wait(0.2)
    end
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local net = modules and modules:FindFirstChild("Net")
    local speak = net and net:FindFirstChild("RF/SubmarineWorkerSpeak")
    if speak then pcall(function() speak:InvokeServer("TravelToSubmergedIsland") end) end
    local verify = os.clock()
    while os.clock() - verify < 5 and _G.LilyAutoFarmLevel do
        if isSubmerged() then return true end
        task.wait(0.25)
    end
    state.submergedUnavailable = true
    return false
end

local function updateRouteOnce(reason)
    local data = LP:FindFirstChild("Data")
    local lv = data and data:FindFirstChild("Level")
    local level = lv and tonumber(lv.Value)
    if not level then
        state.status = "WAITING FOR PLAYER DATA"
        return false
    end
    state.level = level
    if level >= MAX_LEVEL then
        state.status = "MAX LEVEL"
        state.quest = "MAX LEVEL"
        state.mob = "-"
        state.route = nil
        state.lastLevelCheck = level
        state.needLevelCheck = false
        return true
    end

    local worldWanted = level >= 1500 and 3 or (level >= 700 and 2 or 1)
    if worldWanted ~= currentWorld() then
        state.status = "GOING TO SEA " .. tostring(worldWanted)
        travelWorld(worldWanted)
        return false
    end

    local route = resolveRoute(level)
    if not route then
        state.status = "ROUTE NOT FOUND"
        return false
    end
    state.route = route
    state.lastLevelCheck = level
    state.needLevelCheck = false
    state.quest = string.format("%s [%d]", route.quest, route.qlv)
    state.mob = route.mob
    state.status = reason or "LEVEL CHECKED"
    return true
end

local function startQuest(route)
    if not route then return false end
    if questMatches(route.mob) then return true end

    if questVisible() then
        safeCommF("AbandonQuest")
        task.wait(0.1)
    end

    if route.area == "Submerged Island" and not isSubmerged() then
        if not tryEnterSubmerged() then
            state.route = lateRoute(state.level)
            if state.route and state.route.area ~= "Tiki Outpost (fallback)" then
                state.route = {world=3, area="Tiki Outpost (fallback)", mob="Isle Champion", quest="TikiQuest2", qlv=2,
                    q=CFrame.new(-16542.4473, 55.6863, 1044.4165), m=CFrame.new(-16848.9414, 21.6863, 1041.4491)}
            end
            route = state.route
            state.quest = string.format("%s [%d]", route.quest, route.qlv)
            state.mob = route.mob
            state.status = "SUBMERGED LOCKED • TIKI FALLBACK"
        end
    end

    if not route then return false end
    tweenTo(route.q, QUEST_DISTANCE)
    local t = os.clock()
    while _G.LilyAutoFarmLevel and os.clock() - t < 10 do
        local root = getRoot()
        if not root then task.wait(0.25)
        elseif (root.Position - route.q.Position).Magnitude <= QUEST_DISTANCE then break
        else task.wait(0.12) end
    end
    if not _G.LilyAutoFarmLevel then return false end
    safeCommF("StartQuest", route.quest, route.qlv)
    task.wait(0.2)
    return questMatches(route.mob)
end

local function getTarget(route)
    local enemies = Workspace:FindFirstChild("Enemies")
    local root = getRoot()
    if not enemies or not root or not route then return nil end
    local best, bestDist
    for _, mob in ipairs(enemies:GetChildren()) do
        if mob.Name == route.mob then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local hrp = mob:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                local d = (hrp.Position - root.Position).Magnitude
                if not best or d < bestDist then best, bestDist = mob, d end
            end
        end
    end
    return best
end

local function farmTarget(route, mob)
    state.target = mob
    state.status = "FARMING " .. tostring(route.mob)
    local lastMove = 0
    while _G.LilyAutoFarmLevel and mob and mob.Parent do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local hrp = mob:FindFirstChild("HumanoidRootPart")
        local root = getRoot()
        if not hum or not hrp or hum.Health <= 0 or not root then break end
        if os.clock() - lastMove >= MOVE_INTERVAL then
            tweenTo(hrp.CFrame * CFrame.new(0, ABOVE_Y, 0), 5)
            lastMove = os.clock()
        end
        equipWeapon()
        enableHaki()
        attack()
        task.wait(ATTACK_INTERVAL)
        if not questVisible() then break end
    end
    state.target = nil
end

local running = false
local function setFarm(on)
    _G.LilyAutoFarmLevel = on == true
    if not _G.LilyAutoFarmLevel then
        running = false
        stopTween()
        state.status = "OFF"
        return
    end
    if running then return end
    running = true
    state.needLevelCheck = true

    task.spawn(function()
        while _G.LilyAutoFarmLevel do
            local ok = pcall(function()
                local data = LP:FindFirstChild("Data")
                local lv = data and data:FindFirstChild("Level")
                local level = lv and tonumber(lv.Value)
                if not level then task.wait(0.4); return end
                state.level = level
                if level >= MAX_LEVEL then
                    state.status = "MAX LEVEL"
                    state.quest = "MAX LEVEL"
                    state.mob = "-"
                    _G.LilyAutoFarmLevel = false
                    return
                end

                if state.needLevelCheck or not state.route then
                    updateRouteOnce("LEVEL CHECKED")
                    task.wait(0.12)
                    return
                end

                if state.lastLevelCheck ~= level and not questVisible() then
                    state.needLevelCheck = true
                    state.status = "QUEST COMPLETE • CHECKING LEVEL"
                    task.wait(LEVEL_CHECK_DELAY)
                    return
                end

                local route = state.route
                if not route then state.needLevelCheck = true; task.wait(0.25); return end

                if not questMatches(route.mob) then
                    startQuest(route)
                    task.wait(0.15)
                    return
                end

                local target = getTarget(route)
                if target then
                    farmTarget(route, target)
                    return
                end

                if questVisible() then
                    state.status = "WAITING FOR MOB"
                    task.wait(0.18)
                else
                    state.needLevelCheck = true
                    state.status = "QUEST COMPLETE • CHECKING LEVEL"
                    task.wait(LEVEL_CHECK_DELAY)
                end
            end)
            if not ok then
                state.status = "RECOVERING"
                task.wait(0.45)
            end
        end
        stopTween()
        _G.AutoLevel = false
        _G.bringmob = false
        running = false
    end)
end

farmBtn.MouseButton1Click:Connect(function()
    setFarm(not _G.LilyAutoFarmLevel)
end)

--==================================================
-- UI STATUS — CACHED / LOW FREQUENCY
--==================================================
task.spawn(function()
    local prev = {}
    while gui.Parent do
        local enabled = _G.LilyAutoFarmLevel == true
        local lv = tostring(state.level > 0 and state.level or "-")
        local w = tostring(currentWorld())
        local q = tostring(state.quest)
        local m = tostring(state.mob)
        local s = tostring(state.status)
        if prev.enabled ~= enabled then
            farmBtn.Text = enabled and "AUTO FARM LEVEL   •   ON" or "AUTO FARM LEVEL   •   OFF"
            farmBtn.BackgroundColor3 = enabled and Color3.fromRGB(49, 36, 68) or Color3.fromRGB(36, 33, 48)
            prev.enabled = enabled
        end
        if prev.s ~= s then statusText.Text = "Status: " .. s; prev.s = s end
        if prev.lv ~= lv then levelText.Text = "Level: " .. lv; prev.lv = lv end
        if prev.w ~= w then worldText.Text = "World: " .. w; prev.w = w end
        if prev.q ~= q then questText.Text = "Quest: " .. q; prev.q = q end
        if prev.m ~= m then mobText.Text = "Mob: " .. m; prev.m = m end
        task.wait(0.8)
    end
end)

--==================================================
-- INITIAL CHECK ON EXECUTE
--==================================================
task.spawn(function()
    if not IN_BLOX_FRUITS then
        state.status = "NOT BLOX FRUITS"
        return
    end
    local data = LP:FindFirstChild("Data") or LP:WaitForChild("Data", 8)
    local lv = data and (data:FindFirstChild("Level") or data:WaitForChild("Level", 5))
    if lv then
        state.level = tonumber(lv.Value) or 0
        updateRouteOnce("READY")
    else
        state.status = "PLAYER DATA NOT READY"
    end
end)

pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "LILY",
    Text = IN_BLOX_FRUITS and "Loaded successfully • RightShift = menu" or "Open Blox Fruits first",
    Duration = 3
}) end)
