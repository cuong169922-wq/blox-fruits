local function smallButton(text, x)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(34, 30)
    b.Position = UDim2.new(1, x, 0, 15)
    b.BackgroundColor3 = Color3.fromRGB(35, 32, 46)
    b.BorderSizePixel = 0
    b.Font = Enum.Font.GothamBold
    b.Text = text
    b.TextSize = 18
    b.TextColor3 = Color3.fromRGB(225, 220, 237)
    b.AutoButtonColor = false
    b.Parent = header
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = b
    return b
end

