-- LILY RealPC Fixed — standalone build
-- No Fluent / SaveManager / InterfaceManager dependency.
-- The LILY controller is initialized before any legacy hub code would run.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local LP = Players.LocalPlayer
if not LP then return end

pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "LILY",
    Text = "Loading standalone client...",
    Duration = 2
}) end)

local function chooseGuiParent()
    -- Real Roblox client compatibility: PlayerGui is the safest normal client parent.
    local ok, playerGui = pcall(function()
        return LP:FindFirstChildOfClass("PlayerGui") or LP:WaitForChild("PlayerGui", 10)
    end)
    if ok and playerGui then return playerGui end

    -- Executor-specific fallback only when PlayerGui is unavailable.
    local ok2, hui = pcall(function()
        if type(gethui) == "function" then
            return gethui()
        end
    end)
    if ok2 and hui then return hui end

    local ok3, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok3 and cg then return cg end
    return nil
end

local GuiParent = chooseGuiParent()
if not GuiParent then
    pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "LILY",
        Text = "PlayerGui unavailable - execute after entering Blox Fruits",
        Duration = 5
    }) end)
    return
end

